function(lab_find_mlx)
  set(LAB_MLX_ROOT "" CACHE PATH "Explicit MLX SDK root supplied by the locked tools environment")
  if(NOT LAB_MLX_ROOT)
    message(FATAL_ERROR "Set LAB_MLX_ROOT explicitly; use .venv/bin/python cmake/mlx/locate_sdk.py")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/cmake/mlx/locate_sdk.py"
    --root "${LAB_MLX_ROOT}" RESULT_VARIABLE lab_sdk_status
    OUTPUT_VARIABLE lab_sdk_json ERROR_VARIABLE lab_sdk_error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT lab_sdk_status EQUAL 0)
    message(FATAL_ERROR "MLX SDK validation failed: ${lab_sdk_error}")
  endif()
  string(JSON lab_root GET "${lab_sdk_json}" root)
  string(JSON lab_version GET "${lab_sdk_json}" version)
  set(LAB_MLX_ROOT "${lab_root}" CACHE PATH "Explicit validated MLX SDK root" FORCE)
  set(LAB_MLX_VERSION "${lab_version}" PARENT_SCOPE)
  set(LAB_MLX_METALLIB "${lab_root}/lib/mlx.metallib" PARENT_SCOPE)
  # Do not allow a cached MLX_DIR or a system package to substitute another SDK.
  set(MLX_DIR "${lab_root}/share/cmake/MLX" CACHE PATH "Validated MLX package config" FORCE)
  find_package(MLX "${lab_version}" EXACT CONFIG REQUIRED PATHS "${MLX_DIR}" NO_DEFAULT_PATH)
  get_target_property(lab_location mlx IMPORTED_LOCATION_RELEASE)
  file(REAL_PATH "${lab_location}" lab_location)
  if(NOT lab_location STREQUAL "${lab_root}/lib/libmlx.dylib")
    message(FATAL_ERROR "MLX imported target does not point at the selected SDK")
  endif()
  # This wheel exports its build host's absolute SDK framework paths. Resolve
  # the same frameworks in the current SDK, preserving the original link chain.
  get_target_property(lab_links mlx INTERFACE_LINK_LIBRARIES)
  set(lab_local_links "")
  foreach(lab_link IN LISTS lab_links)
    if(lab_link MATCHES "^/.*/([^/]+)\\.framework$" AND NOT EXISTS "${lab_link}")
      set(lab_framework_name "${CMAKE_MATCH_1}")
      find_library(LAB_FRAMEWORK_${lab_framework_name} NAMES "${lab_framework_name}" REQUIRED)
      message(STATUS "Resolve MLX framework ${lab_framework_name} in local SDK")
      list(APPEND lab_local_links "${LAB_FRAMEWORK_${lab_framework_name}}")
    else()
      list(APPEND lab_local_links "${lab_link}")
    endif()
  endforeach()
  set_target_properties(mlx PROPERTIES INTERFACE_LINK_LIBRARIES "${lab_local_links}")
  message(STATUS "Selected MLX ${lab_version}: ${lab_root}")
endfunction()
